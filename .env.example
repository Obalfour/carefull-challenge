## LLM
LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL_ID=gemini-3.1-flash-lite
# Requests per minute per model (free tier: 15). 0 = no limit (paid key).
LLM_MAX_RPM=14
LLM_MAX_WORKERS=8

## Detection thresholds (empty or missing = default value)
# Amount spike: debit > ROLLING_MULTIPLIER x mean of the user's debits in ROLLING_WINDOW
ROLLING_WINDOW=30D
ROLLING_MULTIPLIER=1.5
# A spike becomes an alert if the user had another spike within this lookback
ESCALATION_LOOKBACK=7D
# Money mule: credit followed within MULE_WINDOW_HOURS by an outgoing transfer of
# MULE_RATIO_MIN..MULE_RATIO_MAX of its amount
MULE_WINDOW_HOURS=72
MULE_RATIO_MIN=0.85
MULE_RATIO_MAX=1.0
# Weekly overspend: weekly spend > WEEKLY_MULTIPLIER x mean of the previous WEEKLY_BASELINE_WEEKS
WEEKLY_BASELINE_WEEKS=4
WEEKLY_MIN_HISTORY_WEEKS=2
WEEKLY_MULTIPLIER=1.5
# true = only flag the week's debits at merchants the user never used before
WEEKLY_ONLY_NEW_MERCHANTS=true

## Enrichment and validation
ENTITY_MIN_CONFIDENCE=0.7
# LLM verdicts below this confidence go to human review as suspicious
VALIDATION_MIN_CONFIDENCE=0.6
VALIDATION_BASELINE_DAYS=90
VALIDATION_RECENT_DAYS=30
VALIDATION_MAX_RECENT_TRANSACTIONS=25
